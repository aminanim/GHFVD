THREADS=16
INPUT_VOTUS="votu_representatives.fna"
TANI=0.70
GENUS_CLUSTERS="genus_clusters.tsv"

# ---------------- Genus-level clustering (vClust) ----------------
vclust prefilter -i "$INPUT_VOTUS" -o genus_filter.txt --threads $THREADS

vclust align -i "$INPUT_VOTUS" -o genus_ani.tsv --filter genus_filter.txt --threads $THREADS

vclust cluster -i genus_ani.tsv -o "$GENUS_CLUSTERS" --ids genus_ani.ids.tsv \
    --algorithm complete --metric tani --tani $TANI
