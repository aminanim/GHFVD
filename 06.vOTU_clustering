THREADS=16
INPUT_CONTIGS="checkv_output/checkv_passed.fna"
ANI=0.95
QCOV=0.85
VOTU_FASTA="votu_representatives.fna"
 
# ---------------- vOTU clustering (vClust) ----------------
vclust prefilter -i "$INPUT_CONTIGS" -o filter.txt --threads $THREADS
 
vclust align -i "$INPUT_CONTIGS" -o ani.tsv --filter filter.txt --threads $THREADS
 
vclust cluster -i ani.tsv -o clusters.tsv --ids ani.ids.tsv \
    --metric ani --ani $ANI --qcov $QCOV
 
vclust info -i "$INPUT_CONTIGS" -c clusters.tsv -o "$VOTU_FASTA" --representatives
